# Telegram Bot Token (от @BotFather)
BOT_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZ

# ID супергруппы (форума), куда бот будет слать лоты (обычно начинается с -100...)
TELEGRAM_GROUP_ID=-1001234567890

# ID тем (топиков форума) для фильтрации:
# Топик 1: Дешёвые подарки (1 - 5 TON/GRAM)
TOPIC_CHEAP_ID=2
# Топик 2: Средние подарки (5 - 20 TON/GRAM)
TOPIC_MEDIUM_ID=3
# Топик 3: Дорогие подарки (20 - 100 TON/GRAM)
TOPIC_EXPENSIVE_ID=4
# Топик 4: Подарки девушек (до 100 TON/GRAM)
TOPIC_GIRLS_ID=5
# Топик 5: Улучшенные подарки (без цены, только улучшенные за звёзды)
TOPIC_UPGRADED_ID=6

# Кулдаун на взятие лота (в секундах, по ТЗ - 5 секунд)
CLAIM_COOLDOWN_SECONDS=5

# Действие с сообщением в группе после занятия лота: "delete" (удалить) или "edit" (изменить на "Занято")
CLAIM_ACTION=delete

# Данные для Telethon (официальный нативный Telegram MTProto API)
# Получить на https://my.telegram.org (по умолчанию используются официальные ключи Telegram)
TELEGRAM_API_ID=2040
TELEGRAM_API_HASH=b18441a1ff607e10a989891a5462e627
TELEGRAM_SESSION_NAME=session_checker

# Строковые сессии для работы на облачном хостинге (необязательно, если есть sessions.txt)
TELEGRAM_SESSIONS=
